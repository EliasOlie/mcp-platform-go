# ==============================================================================
# CORE-UTILS SUITE — VARIÁVEIS DE AMBIENTE (DOKPLOY / PRODUÇÃO)
# ==============================================================================

# 1. Banco de Dados PostgreSQL (Janus + Auth Service)
# Utiliza o banco app_janus_local com pgvector ativo
DATABASE_URL=postgresql://app_janus_local_admin:CHANGE_ME@db.example.com:6432/app_janus_local?sslmode=disable

# 2. Master Secret Key (Auth Service)
# Chave mestra usada exclusivamente para criar novos tenants e emitir novas API Keys via POST /auth/keys
ADMIN_MASTER_KEY=eo_master_live_d84f912b7a0e44319c72e293817a0b6e

# 3. Identidade & Tokens JWT
AUTH_ISSUER=https://auth.example.com
AUTH_AUDIENCE=eliasolie-platform

# 4. Provedor de Embeddings (VPSQL AI Gateway para RAG Híbrido do Janus)
AI_GATEWAY_URL=https://vpsql.example.com
AI_GATEWAY_KEY=vpsql_sk_live_fa2b0f3f0f89954a76f967c88d7c2e47
SEARCH_TOP_K=10

# 5. Domínio Público do MCP Hub (Descoberta RFC 9728)
PUBLIC_URL=https://mcp.example.com

# 6. Portas de Host (opcionais, default: 8081 para Auth e 8082 para MCP)
AUTH_PORT=8081
MCP_PORT=8082
